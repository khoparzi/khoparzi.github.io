---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="404 - Page Not Found">
  <div style="text-align: center; padding: 4rem 1rem;">
    <p style="font-family: var(--font-mono); font-size: 3rem; color: var(--color-primary); font-weight: 800; margin: 0;">404</p>
    <p style="font-size: 1.25rem; color: var(--color-text-muted); margin-top: 1rem;">The page you are looking for does not exist or has moved.</p>
    <a href="/" class="btn btn-primary" style="margin-top: 2rem;">&larr; Return Home</a>
  </div>
</PageLayout>
